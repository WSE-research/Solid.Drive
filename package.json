{
  "name": "solid.drive",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "tbox:extract": "node scripts/extract-tbox.mjs",
    "dev": "node scripts/extract-tbox.mjs && vite",
    "build": "node scripts/extract-tbox.mjs && tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "build:ldo": "ldo build --input src/.shapes --output src/.ldo && node scripts/fix-ldo-types.mjs",
    "pwa:icons": "node scripts/generate-pwa-icons.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:bench": "vitest run --config vitest.bench.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@fluentui/react-icons": "^2.0.347",
    "@ldo/ldo": "1.0.0-alpha.51",
    "@ldo/solid": "^1.0.0-alpha.1",
    "@ldo/solid-react": "1.0.0-alpha.51",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "buffer": "^6.0.3",
    "i18next": "^27.2.2",
    "i18next-browser-languagedetector": "^8.3.1",
    "n3": "^2.13.12",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.3",
    "react-router-dom": "^7.18.6",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@inrupt/solid-client-authn-node": "5.0.3",
    "@ldo/cli": "^1.0.0-alpha.53",
    "@ldo/connected-solid": "1.0.0-alpha.53",
    "@playwright/test": "1.65.1",
    "@rdfjs/types": "^2.0.1",
    "@solid/community-server": "8.0.0-alpha.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/jsonld": "^1.5.15",
    "@types/n3": "^1.26.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/shexj": "^2.1.7",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "n3": "^2.13.12",
    "rdf-validate-shacl": "^0.7.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  },
  "optionalDependencies": {
    "@rollup/rollup-darwin-arm64": "^4.68.8",
    "@rollup/rollup-darwin-x64": "^4.68.8",
    "@rollup/rollup-linux-arm64-gnu": "^4.68.8",
    "@rollup/rollup-linux-x64-gnu": "^4.68.8",
    "@rollup/rollup-linux-x64-musl": "^4.68.8"
  },
  "overrides": {
    "child-process-promise": {
      "cross-spawn": "^7.0.6"
    }
  }
}
