# Fails: a folder row below the storage root has no tag.
# role: catalog
# document: https://pod.example/alice/catalog.ttl
# expect: sdsh:FolderRowKindShape OrConstraintComponent
@prefix as: <https://www.w3.org/ns/activitystreams#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix schema: <http://schema.org/> .
@prefix sd: <https://purl.org/solid-drive/catalog#> .
@prefix trash: <https://purl.org/solid-drive/trash#> .
@prefix w3idtrash: <https://w3id.org/trash#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<> a dcat:Catalog ;
  dcat:dataset <https://pod.example/alice/projects/> .
<https://pod.example/alice/projects/> a dcat:Dataset, sd:Folder ;
  dcterms:conformsTo sd:Folder ;
  dcterms:title "Projects" ;
  dcterms:modified "2026-11-01T12:01:00.000Z"^^xsd:dateTime ;
  dcterms:publisher <https://pod.example/alice/profile/card#me> ;
  sd:hasParent <https://pod.example/alice/> .
